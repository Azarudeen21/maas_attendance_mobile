{
  "doctype": "DocType",
  "name": "Mobile Attendance Company Policy",
  "module": "MAAS Attendance Mobile",
  "engine": "InnoDB",
  "autoname": "field:company",
  "field_order": [
    "company",
    "enabled",
    "test_employee",
    "require_test_photo",
    "require_test_location",
    "require_approved_device",
    "enable_offline_test",
    "photo_retention_section",
    "photo_retention_days",
    "enable_photo_cleanup",
    "production_section",
    "enable_production_attendance",
    "enable_production_offline",
    "production_require_photo",
    "production_require_location"
  ],
  "fields": [
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "label": "Company",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enable Company Test Attendance",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "test_employee",
      "fieldtype": "Link",
      "options": "Employee",
      "label": "Dedicated Test Employee",
      "reqd": 0
    },
    {
      "fieldname": "require_test_photo",
      "fieldtype": "Check",
      "label": "Require Punch Photo and GPS",
      "default": "0"
    },
    {
      "fieldname": "require_test_location",
      "fieldtype": "Check",
      "label": "Require GPS Workplace Check",
      "default": "0"
    },
    {
      "fieldname": "require_approved_device",
      "fieldtype": "Check",
      "label": "Require Approved Device",
      "default": "0"
    },
    {
      "fieldname": "enable_offline_test",
      "fieldtype": "Check",
      "label": "Enable Offline Test Claims",
      "default": "0"
    },
    {
      "fieldtype": "Section Break",
      "label": "Photo Retention",
      "fieldname": "photo_retention_section"
    },
    {
      "fieldtype": "Int",
      "description": "Zero keeps photos. Count from upload; offline photos also remain for this interval after final HR review. Holds override cleanup.",
      "label": "Keep Photo for Days",
      "fieldname": "photo_retention_days",
      "default": "0"
    },
    {
      "fieldtype": "Check",
      "description": "Opt-in hourly cleanup. Retains punch records and evidence hashes. Does not remove backups or shared files.",
      "label": "Enable Automatic Photo Cleanup",
      "fieldname": "enable_photo_cleanup",
      "default": "0"
    },
    {
      "fieldname": "production_section",
      "label": "Production employee policy",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "enable_production_attendance",
      "label": "Enable Company Production Attendance",
      "default": "0",
      "fieldtype": "Check"
    },
    {
      "fieldname": "enable_production_offline",
      "label": "Enable Company Production Offline Claims",
      "default": "0",
      "fieldtype": "Check"
    },
    {
      "fieldname": "production_require_photo",
      "label": "Require Production Photo and GPS",
      "default": "1",
      "fieldtype": "Check"
    },
    {
      "fieldname": "production_require_location",
      "label": "Require Production Workplace GPS",
      "default": "1",
      "fieldtype": "Check"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR Manager",
      "read": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC"
}