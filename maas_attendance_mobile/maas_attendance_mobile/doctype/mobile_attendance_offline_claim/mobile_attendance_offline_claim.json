{
  "module": "MAAS Attendance Mobile",
  "field_order": [
    "request_id",
    "employee",
    "user",
    "registered_device",
    "log_type",
    "event_time",
    "status",
    "checkin",
    "reviewed_by",
    "reviewed_at",
    "review_reason",
    "request_hash",
    "payload_json",
    "punch_photo",
    "photo_company",
    "photo_uploaded_at",
    "photo_retention_hold",
    "photo_hold_reason",
    "photo_hold_by",
    "photo_hold_at",
    "photo_removed_at",
    "photo_cleanup",
    "test_mode",
    "event_company"
  ],
  "doctype": "DocType",
  "sort_order": "ASC",
  "name": "Mobile Attendance Offline Claim",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    },
    {
      "role": "HR Manager",
      "read": 1
    }
  ],
  "sort_field": "event_time",
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "request_id",
      "read_only": 1,
      "fieldtype": "Data",
      "unique": 1,
      "label": "Request ID",
      "reqd": 1
    },
    {
      "fieldname": "employee",
      "read_only": 1,
      "options": "Employee",
      "fieldtype": "Link",
      "in_list_view": 1,
      "label": "Employee"
    },
    {
      "read_only": 1,
      "fieldname": "user",
      "options": "User",
      "label": "User",
      "fieldtype": "Link"
    },
    {
      "read_only": 1,
      "fieldname": "registered_device",
      "options": "Mobile Attendance Device",
      "label": "Registered Device",
      "fieldtype": "Link"
    },
    {
      "fieldname": "log_type",
      "read_only": 1,
      "options": "IN\nOUT",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Log Type"
    },
    {
      "in_list_view": 1,
      "read_only": 1,
      "fieldname": "event_time",
      "label": "Original Site Time",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "status",
      "read_only": 1,
      "options": "Pending Review\nApproved\nRejected",
      "default": "Pending Review",
      "fieldtype": "Select",
      "in_list_view": 1,
      "label": "Status",
      "reqd": 1
    },
    {
      "read_only": 1,
      "fieldname": "checkin",
      "options": "Employee Checkin",
      "label": "Checkin",
      "fieldtype": "Link"
    },
    {
      "read_only": 1,
      "fieldname": "reviewed_by",
      "options": "User",
      "label": "Reviewed By",
      "fieldtype": "Link"
    },
    {
      "read_only": 1,
      "fieldname": "reviewed_at",
      "label": "Reviewed At",
      "fieldtype": "Datetime"
    },
    {
      "read_only": 1,
      "fieldname": "review_reason",
      "label": "Review Reason",
      "fieldtype": "Small Text"
    },
    {
      "hidden": 1,
      "read_only": 1,
      "fieldname": "request_hash",
      "label": "Request Hash",
      "fieldtype": "Data"
    },
    {
      "read_only": 1,
      "fieldname": "payload_json",
      "label": "Original Evidence",
      "fieldtype": "Long Text"
    },
    {
      "read_only": 1,
      "label": "Private Punch Photo",
      "description": "Photo evidence only. No identity or liveness check.",
      "fieldname": "punch_photo",
      "fieldtype": "Attach Image"
    },
    {
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Company",
      "label": "Photo Company at Upload",
      "fieldname": "photo_company"
    },
    {
      "fieldtype": "Datetime",
      "read_only": 1,
      "label": "Photo Uploaded At",
      "fieldname": "photo_uploaded_at"
    },
    {
      "fieldtype": "Check",
      "read_only": 1,
      "label": "Keep Photo on Hold",
      "fieldname": "photo_retention_hold",
      "default": "0"
    },
    {
      "fieldtype": "Small Text",
      "read_only": 1,
      "label": "Photo Hold Reason",
      "fieldname": "photo_hold_reason"
    },
    {
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User",
      "label": "Hold Changed By",
      "fieldname": "photo_hold_by"
    },
    {
      "fieldtype": "Datetime",
      "read_only": 1,
      "label": "Hold Changed At",
      "fieldname": "photo_hold_at"
    },
    {
      "fieldtype": "Datetime",
      "read_only": 1,
      "label": "Photo Removed At",
      "fieldname": "photo_removed_at"
    },
    {
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Mobile Attendance Photo Cleanup",
      "label": "Photo Cleanup Audit",
      "fieldname": "photo_cleanup"
    },
    {
      "fieldname": "test_mode",
      "label": "Test Mode",
      "read_only": 1,
      "default": "1",
      "fieldtype": "Check"
    },
    {
      "fieldname": "event_company",
      "label": "Company at Upload",
      "read_only": 1,
      "options": "Company",
      "fieldtype": "Link"
    }
  ],
  "autoname": "field:request_id",
  "track_changes": 1
}