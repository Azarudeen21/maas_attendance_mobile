{
  "doctype": "DocType",
  "name": "Mobile Attendance Transaction",
  "module": "MAAS Attendance Mobile",
  "engine": "InnoDB",
  "field_order": [
    "request_id",
    "employee",
    "request_hash",
    "checkin",
    "log_type",
    "event_time",
    "timestamp_utc",
    "device_id",
    "app_version",
    "test_mode",
    "location_json",
    "workplace",
    "distance_m",
    "accuracy_m",
    "registered_device",
    "capture_mode",
    "supervisor",
    "face_score",
    "punch_photo",
    "photo_sha256",
    "photo_captured_at",
    "photo_company",
    "photo_uploaded_at",
    "photo_retention_hold",
    "photo_hold_reason",
    "photo_hold_by",
    "photo_hold_at",
    "photo_removed_at",
    "photo_cleanup"
  ],
  "fields": [
    {
      "fieldname": "request_id",
      "fieldtype": "Data",
      "label": "Request UUID",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Employee",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "request_hash",
      "fieldtype": "Data",
      "label": "Request SHA256",
      "reqd": 1
    },
    {
      "fieldname": "checkin",
      "fieldtype": "Link",
      "label": "Employee Checkin",
      "options": "Employee Checkin",
      "reqd": 1
    },
    {
      "fieldname": "log_type",
      "fieldtype": "Select",
      "label": "Log Type",
      "options": "IN\nOUT",
      "reqd": 1
    },
    {
      "fieldname": "event_time",
      "fieldtype": "Datetime",
      "label": "Site Event Time",
      "reqd": 1
    },
    {
      "fieldname": "timestamp_utc",
      "fieldtype": "Data",
      "label": "Original Event UTC",
      "reqd": 1
    },
    {
      "fieldname": "device_id",
      "fieldtype": "Data",
      "label": "Installation UUID",
      "reqd": 1
    },
    {
      "fieldname": "app_version",
      "fieldtype": "Data",
      "label": "App Version",
      "reqd": 1
    },
    {
      "fieldname": "test_mode",
      "fieldtype": "Check",
      "label": "Test Mode",
      "default": "1",
      "read_only": 1
    },
    {
      "fieldname": "location_json",
      "fieldtype": "Small Text",
      "label": "Original GPS Payload",
      "read_only": 1
    },
    {
      "fieldname": "workplace",
      "fieldtype": "Link",
      "options": "Mobile Attendance Workplace",
      "label": "Validated Workplace",
      "read_only": 1
    },
    {
      "fieldname": "distance_m",
      "fieldtype": "Float",
      "precision": "3",
      "label": "Distance from Centre (metres)",
      "read_only": 1
    },
    {
      "fieldname": "accuracy_m",
      "fieldtype": "Float",
      "precision": "3",
      "label": "GPS Uncertainty (metres)",
      "read_only": 1
    },
    {
      "fieldname": "registered_device",
      "fieldtype": "Link",
      "options": "Mobile Attendance Device",
      "label": "Approved Device",
      "read_only": 1
    },
    {
      "read_only": 1,
      "label": "Private Punch Photo",
      "description": "Photo evidence only. No identity or liveness check.",
      "fieldname": "punch_photo",
      "fieldtype": "Attach Image"
    },
    {
      "read_only": 1,
      "label": "Original Photo SHA256",
      "fieldname": "photo_sha256",
      "fieldtype": "Data"
    },
    {
      "read_only": 1,
      "label": "Photo Captured UTC",
      "fieldname": "photo_captured_at",
      "fieldtype": "Data"
    },
    {
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Company",
      "label": "Photo Company at Upload",
      "fieldname": "photo_company"
    },
    {
      "fieldtype": "Datetime",
      "read_only": 1,
      "label": "Photo Uploaded At",
      "fieldname": "photo_uploaded_at"
    },
    {
      "fieldtype": "Check",
      "read_only": 1,
      "label": "Keep Photo on Hold",
      "fieldname": "photo_retention_hold",
      "default": "0"
    },
    {
      "fieldtype": "Small Text",
      "read_only": 1,
      "label": "Photo Hold Reason",
      "fieldname": "photo_hold_reason"
    },
    {
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User",
      "label": "Hold Changed By",
      "fieldname": "photo_hold_by"
    },
    {
      "fieldtype": "Datetime",
      "read_only": 1,
      "label": "Hold Changed At",
      "fieldname": "photo_hold_at"
    },
    {
      "fieldtype": "Datetime",
      "read_only": 1,
      "label": "Photo Removed At",
      "fieldname": "photo_removed_at"
    },
    {
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Mobile Attendance Photo Cleanup",
      "label": "Photo Cleanup Audit",
      "fieldname": "photo_cleanup"
    },
    {
      "fieldname": "capture_mode",
      "fieldtype": "Select",
      "options": "Self\nSupervisor",
      "default": "Self",
      "label": "Capture Mode",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "supervisor",
      "fieldtype": "Link",
      "options": "User",
      "label": "Supervisor",
      "read_only": 1
    },
    {
      "fieldname": "face_score",
      "fieldtype": "Float",
      "precision": "4",
      "label": "Face Match Score",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    },
    {
      "role": "HR Manager",
      "read": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "autoname": "field:request_id"
}
